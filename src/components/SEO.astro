---
import { SITE_URL, AIRBNB_URL, BOOKING_URL, MAP_URL, PHONE } from '$lib/config';
import { delocalizePath, locales, sitePageUrl } from '$lib/i18n';

interface Props {
	title: string;
	description: string;
	locale: string;
}

const { title, description, locale } = Astro.props;

const OG_IMAGE = `${SITE_URL}/images/ucihuen_open_graph.png`;
const LOCALE_MAP: Record<string, string> = { es: 'es_AR', en: 'en_US', pt: 'pt_BR' };

const ogLocale = LOCALE_MAP[locale] || 'es_AR';
const altLocales = Object.entries(LOCALE_MAP)
	.filter(([k]) => k !== locale)
	.map(([, v]) => v);

const currentPath = delocalizePath(Astro.url.pathname);
const canonicalUrl = sitePageUrl(currentPath, locale);
const isHomePage = currentPath === '/';

const jsonLdData = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'LodgingBusiness',
	name: 'Cabañas Ucihuen',
	description,
	url: SITE_URL,
	telephone: PHONE,
	address: {
		'@type': 'PostalAddress',
		streetAddress: 'Los Alerces 880',
		addressLocality: 'Lago Puelo',
		addressRegion: 'Chubut',
		postalCode: '9211',
		addressCountry: 'AR'
	},
	image: OG_IMAGE,
	hasMap: MAP_URL,
	petsAllowed: true,
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'WiFi', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Parking', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Barbecue grill', value: true }
	],
	sameAs: [AIRBNB_URL, BOOKING_URL, 'https://www.instagram.com/ucihuen/']
});

const webSiteJsonLdData = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'Cabañas Ucihuen',
	url: SITE_URL,
	inLanguage: locale
});

const organizationJsonLdData = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: 'Cabañas Ucihuen',
	url: SITE_URL,
	telephone: PHONE,
	contactPoint: {
		'@type': 'ContactPoint',
		telephone: PHONE,
		contactType: 'reservations and customer service'
	},
	address: {
		'@type': 'PostalAddress',
		streetAddress: 'Los Alerces 880',
		addressLocality: 'Lago Puelo',
		addressRegion: 'Chubut',
		postalCode: '9211',
		addressCountry: 'AR'
	}
});
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
{
	locales.map((loc) => (
		<link rel="alternate" hreflang={loc} href={sitePageUrl(currentPath, loc)} />
	))
}
<link rel="alternate" hreflang="x-default" href={sitePageUrl(currentPath)} />
<meta property="og:site_name" content="Cabañas Ucihuen" />
<meta property="og:type" content="business.business" />
<meta property="og:image" content={OG_IMAGE} />
<meta property="og:locale" content={ogLocale} />
{altLocales.map((alt) => <meta property="og:locale:alternate" content={alt} />)}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={OG_IMAGE} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:url" content={canonicalUrl} />
<script type="application/ld+json" set:html={jsonLdData} />
{isHomePage && <script type="application/ld+json" set:html={organizationJsonLdData} />}
{isHomePage && <script type="application/ld+json" set:html={webSiteJsonLdData} />}
