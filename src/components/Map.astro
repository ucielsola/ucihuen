---
interface Props {
	m: Record<string, string>;
}

const { m } = Astro.props;
---

<div class="wrapper" id="map-wrapper">
	<div class="skeleton" id="map-skeleton" aria-hidden="true">
		<span class="skeleton-icon">
			<svg
				xmlns="http://www.w3.org/2000/svg"
				width="48"
				height="48"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.2"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
				<circle cx="12" cy="10" r="3"></circle>
			</svg>
		</span>
	</div>

	<iframe
		id="map-iframe"
		title={m.home_map_title}
		allowfullscreen
		loading="lazy"
		src="https://storage.googleapis.com/maps-solutions-fzymzrx8e3/commutes/914c/commutes.html"
	></iframe>
</div>
<a
	class="map-link"
	href="https://www.google.com/maps/search/?api=1&query=Caba%C3%B1as%20Ucihuen%2C%20Lago%20Puelo"
	target="_blank"
	rel="noopener noreferrer"
>
	{m.home_map_link}
</a>

<script>
	const skeleton = document.getElementById('map-skeleton');
	const iframe = document.getElementById('map-iframe');
	if (skeleton && iframe) {
		iframe.addEventListener('load', () => {
			skeleton.style.display = 'none';
			iframe.style.opacity = '1';
		});
		setTimeout(() => {
			skeleton.style.display = 'none';
			iframe.style.opacity = '1';
		}, 3000);
	}
</script>

<style>
	.wrapper {
		border-radius: var(--radius-sm);
		background: linear-gradient(var(--accent-teal) 0%, var(--accent-gold) 100%);
		padding: 2px;
		box-shadow: var(--shadow);
		position: relative;
		margin-top: 0.5rem;
	}

	iframe {
		width: 100%;
		aspect-ratio: 16 / 9;
		min-height: 360px;
		border-radius: var(--radius-sm);
		border: none;
		opacity: 0;
		transition: opacity 0.6s ease;
	}

	.map-link {
		display: inline-block;
		margin-top: 0.5rem;
	}

	.skeleton {
		position: absolute;
		inset: 2px;
		border-radius: var(--radius-sm);
		background: var(--bg-color);
		display: flex;
		align-items: center;
		justify-content: center;
		animation: shimmer 1.5s ease-in-out infinite;
	}

	.skeleton-icon {
		color: var(--base-color);
		opacity: 0.15;
	}

	@keyframes shimmer {
		0%,
		100% {
			opacity: 0.5;
		}
		50% {
			opacity: 1;
		}
	}
</style>
