---
import { bookingOptions } from '../lib/config';
import { getAgentTools, stayTopics } from '../lib/data/agentTools';
import { excursions } from '../lib/data/excursions';
import { amenityIcons, getCabins } from '../lib/data/stay';
import { sitePageUrl } from '../lib/i18n';
import { getMessages } from '../lib/messages';

const { locale } = Astro.props;
const m = getMessages(locale);
const tools = getAgentTools(locale);
const cabins = getCabins(locale);

const agentSiteData = {
	stay: {
		name: 'Cabañas Ucihuen',
		source: sitePageUrl('/', locale),
		location: m.faq_location_answer,
		capacity: cabins.map((cabin) => cabin.title),
		cabins: cabins.map(({ title, capacity, bedrooms, floors, rooms }) => ({
			title,
			capacity,
			bedrooms,
			floors,
			rooms
		})),
		bedroomNote: m.agent_bedroom_note,
		amenities: m.home_amenities_desc,
		amenityList: Object.keys(amenityIcons).map((key) => m[key]),
		nearby: `${m.home_desc_2_before} ${m.home_desc_2_link}${m.home_desc_2_after}`
	},
	booking: {
		source: sitePageUrl('/contact', locale),
		message: m.booking_agent_availability,
		options: bookingOptions
	},
	excursionsSource: sitePageUrl('/paseos', locale),
	excursions: excursions.map((excursion) => ({
		name: m[excursion.titleKey],
		description: m[excursion.descKey],
		categories: excursion.tagKeys.map((key) => m[key]),
		directions: excursion.mapsUrl,
		website: excursion.websiteUrl
	}))
};
---

<script define:vars={{ agentSiteData, tools, stayTopics }}>
	const modelContext = document.modelContext ?? navigator.modelContext;
	if (typeof modelContext?.registerTool === 'function') {
		void (async () => {
			const string = { type: 'string' };
			const url = { type: 'string', format: 'uri' };
			const list = (items) => ({ type: 'array', items });
			const object = (properties, required = Object.keys(properties)) => ({
				type: 'object',
				properties,
				required,
				additionalProperties: false
			});
			const { stay, booking, excursions, excursionsSource } = agentSiteData;
			const capacity = {
				capacity: stay.capacity,
				cabins: stay.cabins,
				bedroomNote: stay.bedroomNote
			};
			const amenities = { amenities: stay.amenities, amenityList: stay.amenityList };
			const stayByTopic = {
				location: { location: stay.location },
				capacity,
				amenities,
				nearby: { nearby: stay.nearby }
			};
			const definitions = [
				{
					...tools.stay,
					inputSchema: object({ topic: { type: 'string', enum: stayTopics } }, []),
					outputSchema: object(
						{
							source: url,
							name: string,
							location: string,
							capacity: list(string),
							cabins: list(
								object({
									title: string,
									capacity: { type: 'integer' },
									bedrooms: { type: ['integer', 'null'] },
									floors: string,
									rooms: list(string)
								})
							),
							bedroomNote: string,
							amenities: string,
							amenityList: list(string),
							nearby: string
						},
						['source']
					),
					execute: ({ topic = 'all' } = {}) =>
						stayTopics.includes(topic) && topic !== 'all'
							? { source: stay.source, ...stayByTopic[topic] }
							: stay
				},
				{
					...tools.booking,
					inputSchema: object({}),
					outputSchema: object({
						source: url,
						message: string,
						options: list(object({ name: string, url, phone: string }, ['name', 'url']))
					}),
					execute: () => booking
				},
				{
					...tools.excursions,
					inputSchema: object({ query: { type: 'string', minLength: 1, maxLength: 120 } }),
					outputSchema: object({
						source: url,
						query: string,
						results: list(
							object({
								name: string,
								description: string,
								categories: list(string),
								directions: url,
								website: { type: ['string', 'null'], format: 'uri' }
							})
						)
					}),
					execute: ({ query } = {}) => {
						const search =
							typeof query === 'string' ? [...query.trim()].slice(0, 120).join('') : '';
						const normalize = (value) =>
							value
								.normalize('NFD')
								.replace(/\p{Diacritic}/gu, '')
								.toLocaleLowerCase();
						const term = normalize(search);
						const results = term
							? excursions.filter((excursion) =>
									normalize(
										[excursion.name, excursion.description, ...excursion.categories].join(' ')
									).includes(term)
								)
							: [];
						return { source: excursionsSource, query: search, results };
					}
				}
			];

			for (const tool of definitions) {
				try {
					await modelContext.registerTool({ ...tool, annotations: { readOnlyHint: true } });
				} catch {
					// A rejected registration should leave the other tools and HTML available.
				}
			}
		})();
	}
</script>
