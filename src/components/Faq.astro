---
interface Props {
	m: Record<string, string>;
}

const { m } = Astro.props;

const questions = [
	['faq_location_question', 'faq_location_answer'],
	['faq_capacity_question', 'faq_capacity_answer'],
	['faq_pets_question', 'faq_pets_answer'],
	['faq_wifi_question', 'faq_wifi_answer'],
	['faq_booking_question', 'faq_booking_answer'],
	['faq_breakfast_question', 'faq_breakfast_answer'],
	['faq_parking_question', 'faq_parking_answer']
];
---

<section class="limited-width faq" aria-labelledby="faq-heading">
	<h2 id="faq-heading" class="title">{m.faq_title}</h2>
	<div class="faq__list">
		{
			questions.map(([question, answer]) => (
				<details class="faq__item">
					<summary class="faq__question">
						<span>{m[question]}</span>
						<span class="faq__indicator" aria-hidden="true" />
					</summary>
					<div class="faq__answer">
						<p>{m[answer]}</p>
					</div>
				</details>
			))
		}
	</div>
</section>

<style>
	.faq {
		max-width: 68rem;
		padding-block: var(--space-lg);
	}

	.title {
		margin-block-end: var(--space-md);
		color: var(--base-color);
		text-align: center;
	}

	.faq__list {
		display: grid;
		gap: var(--space-sm);
	}

	.faq__item {
		overflow: hidden;
		border: 1px solid rgba(55, 87, 74, 0.15);
		border-left: 4px solid var(--highlight-color);
		border-radius: var(--radius-sm);
		background: linear-gradient(100deg, var(--surface-color-warm), var(--surface-color));
		box-shadow: var(--shadow);
		transition:
			box-shadow 0.2s ease,
			transform 0.2s ease;
	}

	.faq__item:hover {
		transform: translateY(-1px);
		box-shadow: var(--shadow-lg);
	}

	.faq__question {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		gap: var(--space-md);
		padding: 1rem 1.125rem;
		cursor: pointer;
		font-size: var(--text-base);
		font-weight: var(--font-semibold);
		color: var(--base-color);
		list-style: none;
	}

	.faq__question::-webkit-details-marker {
		display: none;
	}

	.faq__question:focus-visible {
		outline: 3px solid var(--secondary-color);
		outline-offset: -3px;
	}

	.faq__indicator {
		position: relative;
		width: 1.75rem;
		height: 1.75rem;
		border-radius: 50%;
		background: var(--highlight-color);
		transition:
			background-color 0.2s ease,
			transform 0.2s ease;
	}

	.faq__indicator::before {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 0.55rem;
		height: 0.55rem;
		border-right: 2px solid var(--text-color-light);
		border-bottom: 2px solid var(--text-color-light);
		background: transparent;
		content: '';
		transform: translate(-50%, -65%) rotate(45deg);
		transition: transform 0.2s ease;
	}

	.faq__item[open] {
		border-color: rgba(170, 6, 10, 0.25);
	}

	.faq__item[open] .faq__indicator {
		background: var(--primary-color);
	}

	.faq__item[open] .faq__indicator::before {
		transform: translate(-50%, -35%) rotate(225deg);
	}

	.faq__answer {
		border-top: 1px solid rgba(55, 87, 74, 0.15);
		padding: 0 1.125rem 1rem;
	}

	.faq__answer p {
		max-width: 65ch;
		padding-block-start: 0.875rem;
		line-height: var(--leading-relaxed);
		color: var(--base-color);
	}

	@media screen and (min-width: 1024px) {
		.title {
			padding-inline-start: 2rem;
			text-align: start;
		}

		.faq__question {
			padding: 1.125rem 1.5rem;
			font-size: var(--text-lg);
		}

		.faq__answer {
			padding-inline: 1.5rem;
			padding-block-end: 1.125rem;
		}
	}
</style>
