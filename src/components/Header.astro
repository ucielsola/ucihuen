---
import { getMessages } from '$lib/messages';
import { localizeHref } from '$lib/i18n';

interface Props {
	locale: string;
	heading?: string;
}

const { locale, heading } = Astro.props;
const m = getMessages(locale);
---

<header>
	<img
		class="cover"
		src="/images/cover.webp"
		width="2048"
		height="750"
		fetchpriority="high"
		alt="Cabañas Ucihuen - Lago Puelo"
	/>
	<iframe
		id="yt-bg"
		data-src="https://www.youtube.com/embed/ZwqyXout2Xo?autoplay=1&mute=1&loop=1&controls=0&fs=0&showinfo=0&rel=0&playlist=ZwqyXout2Xo&playsinline=1&disablekb=1&modestbranding=1&enablejsapi=1"
		title="Video de fondo - Cabañas Ucihuen"
		frameborder="0"
		allow="autoplay; encrypted-media"
		loading="lazy"></iframe>
	<div class="row">
		<div class="logo">
			<a href={localizeHref('/', locale)} title={m.header_home_title}>
				{
					heading ? (
						<h1>{heading}</h1>
					) : (
						<div class="brand">
							Cabañas <span>Ucihuen</span>
						</div>
					)
				}
			</a>
		</div>
		<p class="copy">
			{m.header_tagline}
		</p>
	</div>
</header>

<script>
	function initHeader() {
		const iframe = document.getElementById('yt-bg') as HTMLIFrameElement | null;
		const cover = document.querySelector('.cover') as HTMLImageElement | null;
		const overlay = document.querySelector('.row') as HTMLDivElement | null;
		if (!iframe || !cover || !overlay) return;
		iframe.src = iframe.dataset.src || '';

		function onPlayerReady(player: any) {
			player.setPlaybackRate(1.25);
			iframe.classList.add('visible');
			cover.classList.add('hidden');
			overlay.classList.add('hidden');
		}

		(window as any).onYTPlayerReady = onPlayerReady;

		if (!(window as any).YT) {
			(window as any).onYouTubeIframeAPIReady = () => {
				createPlayer();
			};
			const tag = document.createElement('script');
			tag.src = 'https://www.youtube.com/iframe_api';
			document.head.appendChild(tag);
		} else {
			createPlayer();
		}

		function createPlayer() {
			new (window as any).YT.Player('yt-bg', {
				events: {
					onReady: (e: any) => onPlayerReady(e.target)
				}
			});
		}

		setTimeout(() => {
			iframe.classList.add('visible');
			cover.classList.add('hidden');
			overlay.classList.add('hidden');
		}, 4000);
	}

	if ('requestIdleCallback' in window) {
		window.requestIdleCallback(initHeader, { timeout: 3000 });
	} else {
		window.setTimeout(initHeader, 1500);
	}
</script>

<style>
	a {
		text-decoration: none;
	}
	header {
		position: relative;
		height: clamp(12rem, 40vw, 36rem);
		overflow: hidden;
	}

	.cover,
	iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: none;
		pointer-events: none;
		object-fit: cover;
	}

	.cover {
		position: relative;
		z-index: 1;
		transition: opacity 1s ease;
	}
	.cover.hidden {
		opacity: 0;
	}

	iframe {
		position: absolute;
		inset: 0;
		height: 100%;
		opacity: 0;
		transition: opacity 1s ease;
	}
	iframe.visible {
		opacity: 1;
	}

	.row {
		position: absolute;
		inset: 0;
		z-index: 2;
		display: grid;
		place-content: end;
		padding-inline: var(--padding-inline);
		padding-block-end: 0.5rem;
		pointer-events: none;
		transition: opacity 1s ease;
	}

	.row.hidden {
		opacity: 0;
		pointer-events: none;
	}

	.row :global(a) {
		pointer-events: auto;
	}

	.logo :is(h1, .brand) {
		font-size: var(--text-4xl);
		line-height: var(--leading-none);
		font-family: var(--font-logo);
		color: var(--secondary-color);
		filter: var(--drop-shadow);
	}

	.logo :is(h1, .brand) span {
		position: relative;
		display: block;
		width: min-content;
		font-size: var(--text-5xl);
		line-height: var(--leading-none);
	}
	.logo :is(h1, .brand) span::after {
		content: 'ᨊ';
		position: absolute;
		top: -3rem;
		right: 1rem;
	}

	.copy {
		color: var(--text-color-light);
		font-family: var(--font-body);
		font-size: var(--text-sm);
		letter-spacing: var(--tracking-tight);
		text-transform: uppercase;
		text-shadow: var(--text-shadow);
	}

	@media screen and (min-width: 1024px) {
		header {
			box-shadow: var(--shadow-lg);
		}

		.row {
			display: flex;
			align-items: center;
			justify-content: center;
		}

		.logo :is(h1, .brand) {
			font-size: 3.5rem;
			line-height: var(--leading-none);
			padding-inline-end: 2rem;
		}

		.logo :is(h1, .brand) span {
			width: min-content;
			font-size: var(--text-6xl);
			line-height: 1.1;
		}
		.logo :is(h1, .brand) span::after {
			top: -4.5rem;
			right: 1rem;
		}

		.copy {
			font-size: var(--text-2xl);
			font-weight: var(--font-semibold);
			letter-spacing: var(--tracking-tight);
			width: 50vw;
			text-shadow: var(--text-shadow);
		}
	}
</style>
