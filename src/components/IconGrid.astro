---
import { amenityIcons } from '$lib/data/stay';
import { getMessages } from '$lib/messages';

interface Props {
	locale: string;
}

const { locale } = Astro.props;
const m = getMessages(locale);

const amenities = Object.entries(amenityIcons).map(([key, icon]) => ({ icon, label: m[key] }));
---

<div class="grid-wrapper" data-aria-show-less={m.aria_show_less} data-aria-show-more={m.aria_show_more}>
	<div class="grid">
		{amenities.map((item, i) => (
			<>
				{i === amenities.length - 1 && <div class="pusher" />}
				<div class="item">
					<img src={`/icons/${item.icon}.webp`} alt={item.label} title={item.label} />
					<span>{item.label}</span>
				</div>
			</>
		))}
	</div>
	<div class="toggle-btn">
		<button aria-expanded="false" aria-label={m.aria_show_more}></button>
	</div>
</div>

<script>
	function initIconGrid() {
		const wrapper = document.querySelector<HTMLElement>('.grid-wrapper');
		const grid = wrapper?.querySelector<HTMLElement>('.grid');
		const btn = wrapper?.querySelector<HTMLButtonElement>('.toggle-btn button');
		if (!wrapper || !grid || !btn) return;

		const ariaShowLess = wrapper.dataset.ariaShowLess || '';
		const ariaShowMore = wrapper.dataset.ariaShowMore || '';

		btn.addEventListener('click', () => {
			const isOpen = grid.classList.toggle('open');
			btn.classList.toggle('turnedUp', isOpen);
			btn.setAttribute('aria-expanded', String(isOpen));
			btn.setAttribute('aria-label', isOpen ? ariaShowLess : ariaShowMore);
		});
	}

	initIconGrid();
</script>

<style>
	.grid-wrapper {
		--toggle-offset: -2rem;
		position: relative;
	}
	.grid {
		position: relative;
		overflow: hidden;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		place-content: start;
		width: 100%;
		min-height: 20rem;
		max-height: 20rem;
		padding-block: 1rem;
		background: var(--grid-gradient);
		border-radius: var(--radius-sm);
		box-shadow: var(--shadow);
		transition: max-height 0.3s var(--easing);
	}
	.grid.open {
		max-height: calc(40rem + 2vh);
		transition: max-height 0.3s var(--easing);
	}
	.toggle-btn {
		position: absolute;
		bottom: var(--toggle-offset);
		width: 100%;
		display: grid;
		place-content: center;
	}

	.toggle-btn button {
		width: 3.5rem;
		height: 3.5rem;
		border: none;
		background-color: transparent;
		background-image: var(--toggle-chevron);
		transition: transform 0.3s var(--easing);
	}
	.toggle-btn button.turnedUp {
		transition: transform 0.3s var(--easing);
		transform: rotate(180deg);
	}

	.item {
		display: flex;
		align-items: center;
		flex-direction: column;
		padding-block: 0.5rem;
	}

	img {
		width: 3rem;
		height: 3rem;
	}
	span {
		font-size: var(--text-sm);
		width: 90%;
		text-align: center;
		text-transform: uppercase;
	}

	@media screen and (min-width: 1024px) {
		.pusher,
		.toggle-btn {
			display: none;
		}

		.grid {
			height: min-content;
			min-height: auto;
			max-height: none;
			grid-template-columns: repeat(4, 1fr);
		}

		img {
			width: 4.5rem;
			height: 4.5rem;
		}
		span {
			font-size: var(--text-base);
		}
	}
</style>
