---
import Layout from '../../layouts/Layout.astro';
import SEO from '../../components/SEO.astro';
import TrustPage from '../../components/TrustPage.astro';
import { PHONE } from '$lib/config';
import AgentResources from '../../components/AgentResources.astro';
import { getMessages, t } from '../../lib/messages';

export function getStaticPaths() {
	return ['en', 'pt'].flatMap((locale) =>
		['about', 'contact', 'privacy', 'agents'].map((slug) => ({ params: { locale, slug } }))
	);
}

const locale = Astro.params.locale || 'en';
const slug = Astro.params.slug as 'about' | 'contact' | 'privacy' | 'agents';
const m = getMessages(locale);
const title = m[`trust_${slug}_title`];
const description = m[`trust_${slug}_meta`];
const content = t(locale, `trust_${slug}_body`, { phone: PHONE });
---

<Layout locale={locale}>
	<SEO slot="head" title={title} description={description} locale={locale} />
	<TrustPage locale={locale} title={title} content={content}>
		{slug === 'agents' && <AgentResources locale={locale} />}
	</TrustPage>
</Layout>
